{
  "name": "api-backend",
  "version": "1.0.0",
  "description": "An api backend",
  "main": "index.js",
  "scripts": {
    "start": "node api/app.js",
    "dev": "nodemon -r dotenv/config api/app.js",
    "docker_dev": "nodemon --legacy-watch ./api/app.js",
    "test": "node --test api/tests/dependencies.test.js api/tests/auth-access.test.js",
    "build": "npm ci --prefix client && npm run build --prefix client"
  },
  "author": "Edgardo Molina",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.19.0",
    "express": "^5.3.0",
    "express-session": "^1.17.2",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "dotenv": "^18.0.9",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  },
  "nodemonConfig": {
    "ignore": [
      "client/"
    ]
  },
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=10"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
